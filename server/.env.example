# SalonFinder Backend Configuration

# Port the Express server will listen on
PORT=5000

# CORS Allowed Origin. Set to your frontend deployment URL (e.g. https://salonfinder.vercel.app) in production
CORS_ORIGIN=*

# Optional: TomTom Search API Key (Get a free key at developer.tomtom.com)
TOMTOM_API_KEY=your_tomtom_api_key_here

# Optional: Google Places API Key
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
